---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TD

  %% Configuration
  config_file@{ shape: doc, label: "Configuration <br><tt>input/config.yaml</tt>" }
  assessment_list@{ shape: rect, label: "Assessments to process" }
  assessment_id@{ shape: rect, label: "Assessment &lt;id&gt;" }
  nli_active@{ shape: rect, label: "Active NLI profile<br/><tt>nli.active</tt>" }

  config_file --> assessment_list
  assessment_list --> assessment_id
  assessment_id --> build_refs

  %% LOD Extraction — grouped so the three parallel queries stay in one horizontal band
  subgraph lod["IPBES LOD Extraction"]
    direction TB

    %% Nodes
    sparql@{ shape: cloud, label: "IPBES SPARQL endpoint" }
    build_refs@{ shape: rect, label: "Extract references<br/>KM → BM → SM → SubChapter ← Reference<br/><tt>[refs_parquet]</tt>" }
    build_key_messages@{ shape: rect, label: "Extract Key/Background Messages<br/>KM → BM (with descriptions)<br/><tt>[key_messages_parquet]</tt>" }

    %% Edges
    sparql <--> build_refs
    sparql <--> build_key_messages
  end

  assessment_id --> build_key_messages

  subgraph data["Retrieve and prepare data"]
    direction TD

    %% Nodes
    refs_db@{ shape: lin-cyl, label: "References DB<br/><tt>output/refs/assessment=&lt;id&gt;/</tt>" }
    key_messages_db@{ shape: lin-cyl, label: "Key + Background Messages DB<br/><tt>output/key_messages/assessment=&lt;id&gt;/</tt>" }
    zotero_api@{ shape: cloud, label: "Zotero API" }
    zotero_db@{ shape: lin-cyl, label: "Zotero DB<br/><tt>output/zotero/assessment=&lt;id&gt;/</tt>" }
    openalex@{ shape: cloud, label: "OpenAlex API" }
    works_db@{ shape: lin-cyl, label: "OpenAlex Works DB<br/><tt>output/works/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    citing_db@{ shape: lin-cyl, label: "Citing Works DB<br/><tt>output/works_citing/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    download_zotero@{ shape: rect, label: "Download Zotero group items<br/>page by page via Zotero API<br/><tt>[zotero_parquet]</tt>" }
    download_works@{ shape: rect, label: "Query OpenAlex works by DOI<br/>via openalexPro<br/><tt>[works_parquet]</tt>" }
    snowball@{ shape: rect, label: "Snowball search<br/>keypaper + citing<br/><tt>[snowball_parquet]</tt>" }
    snowball_db@{ shape: lin-cyl, label: "Snowball DB (nodes / edges / keypaper)<br/><tt>output/snowball/{nodes,edges,keypaper}/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    llm_scope@{ shape: rect, label: "Match citing works per claim via evidence sub-chapter refs<br/>{5.4.1} → refs sm → seed dois → snowball edges → citing works<br/>(naive_bm/atomic_bm only — complete_bm has no per-sub-claim tokens to match)<br/><tt>[llm_candidate_scope_parquet]</tt>" }
    llm_scope_db@{ shape: lin-cyl, label: "Candidate Scope DB<br/><tt>output/llm_candidate_scope/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }

    %% Edges
    build_refs        --> refs_db
    build_key_messages --> key_messages_db

    %% Download spine
    refs_db --> download_zotero
    zotero_api --> download_zotero
    download_zotero --> zotero_db

    zotero_db --> download_works
    openalex <--> download_works
    download_works --> works_db

    works_db --> snowball
    snowball --> snowball_db
    snowball_db --> citing_db

    %% Candidate-scope matching is pure LOD/derived data (no LLM call for
    %% naive_bm/complete_bm) -- belongs here with the rest of data prep,
    %% not in the Phase 2 LLM Verification subgraph it merely feeds.
    key_messages_db --> llm_scope
    refs_db --> llm_scope
    works_db --> llm_scope
    snowball_db --> llm_scope
    llm_scope --> llm_scope_db
  end

  subgraph nli_assessment["Assessment of the alignement of the BMs and the Citing Publications (NLI)"]
    direction TB

    %% Nodes
    nli_segment@{ shape: rect, label: "Segment each BM into claims — per granularity:<br/>naive_bm: evidence-delimited, one claim per sentence-group ending in a {ref} (+ a separate bm_label claim) — 2-17 claims per BM<br/>complete_bm: whole bm_description/bm_label as one claim each — 2 per BM (1 if identical)<br/>atomic_bm: split at EVERY evidence brace, then LLM-complete elliptical fragments into self-contained claims (confidence qualifiers extracted to their own column, same as naive_bm)<br/><tt>[nli_ready_evidence_parquet]</tt> → QA report <tt>[bm_split_report_table -> bm_split_report_html]</tt>" }
    nli_ready_db@{ shape: lin-cyl, label: "NLI-Ready DB (claim × citing-work premise)<br/><tt>output/nli_ready_evidence/granularity=&lt;gran&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    nli_server@{ shape: cloud, label: "Zero-shot NLI server<br/>bge-m3-zeroshot-v2.0-c<br/><tt>external/runpod/docker/nli-runpod/</tt>" }
    nli_scoring@{ shape: rect, label: "Classify each citing work vs one BM claim<br/>premise = clean(title + abstract)<br/>hypothesis = one evidence-segmented BM claim<br/>→ SUPPORTS / REFUTES / NEI<br/><tt>[nli_claim_units_evidence -> nli_claim_units_evidence_flat -> nli_scores_by_claim_evidence]</tt>" }
    nli_scores_db@{ shape: lin-cyl, label: "NLI Scores DB<br/><tt>output/nli_scores_evidence/nli_config=&lt;cfg&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    qa_bm_split@{ shape: doc, label: "QA report<br/><tt>[bm_split_report_html]</tt>" }
    qa_nli_scores@{ shape: doc, label: "QA report<br/><tt>[nli_scores_qa_report_html]</tt>" }
    nli_keypaper_scoring@{ shape: rect, label: "Score KEY/SEED papers vs. their own BM's claim<br/>QA sanity check, not the main corpus — same claims-building + scoring as above, applied to the keypaper snowball partition<br/><tt>[nli_ready_evidence_keypaper_parquet -> nli_scores_keypaper_evidence]</tt>" }
    nli_scores_kp_db@{ shape: lin-cyl, label: "Key-paper NLI Scores DB<br/><tt>output/nli_scores_evidence_keypaper/granularity=&lt;gran&gt;/nli_config=&lt;cfg&gt;/assessment=&lt;id&gt;/</tt>" }

    %% Edges
    nli_segment --> nli_ready_db
    nli_ready_db --> nli_scoring
    nli_server <--> nli_scoring
    nli_scoring --> nli_scores_db
    nli_ready_db --> qa_bm_split
    nli_scores_db --> qa_nli_scores
    nli_server <--> nli_keypaper_scoring
    nli_keypaper_scoring --> nli_scores_kp_db
    nli_scores_kp_db --> qa_nli_scores
  end

  %% Inputs to the NLI scoring step: BM text, segmented into claims first, +
  %% citing works (premise) joined against every claim independently
  key_messages_db --> nli_segment
  citing_db --> nli_ready_db

  %% Inputs to the key-paper QA scoring chain: same BM text as the main
  %% flow, but the keypaper (not citing-work) snowball partition
  key_messages_db --> nli_keypaper_scoring
  snowball_db --> nli_keypaper_scoring

  %% Active NLI profile feeds scoring (determines model config + output partition)
  config_file --> nli_active
  nli_active --> nli_scoring

  %% Force `nli_assessment` to sit below `data` (subgraph-to-subgraph edge).
  %% Made invisible via linkStyle below so it doesn't add visual noise.
  data --> nli_assessment

  subgraph llm_verification["Phase 2 — LLM Verification of Flagged Pairs"]
    direction TB

    %% Nodes
    llm_server@{ shape: cloud, label: "OpenRouter LLM<br/>(gpt-4o-mini / gemini-2.5-flash / gpt-5)" }
    llm_verify@{ shape: rect, label: "Route NLI-scored pairs (label = REFUTES or SUPPORTS, certain only), tag each with direct_evidence_match from the candidate scope above<br/>then call the LLM per (claim, work) — every routed pair reviewed, none filtered — NLI label + confidence as prior<br/>→ SUPPORTS / REFUTES / NEI + verbatim quote<br/><tt>[llm_verification_parquet]</tt>" }
    llm_scores_db@{ shape: lin-cyl, label: "LLM Verification Scores DB<br/><tt>output/llm_verification/scores/llm_config=&lt;cfg&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    llm_verify_keypaper@{ shape: rect, label: "Verify EVERY key/seed paper via LLM — irrespective of NLI label/confidence (no routing, unlike the citing-works chain above)<br/><tt>[llm_verification_keypaper_parquet]</tt>" }
    llm_scores_kp_db@{ shape: lin-cyl, label: "Key-paper LLM Verification Scores DB<br/><tt>output/llm_verification/scores_keypaper/llm_config=&lt;cfg&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    qa_llm_verify@{ shape: doc, label: "QA report<br/><tt>[llm_verification_qa_report_html]</tt>" }

    %% Edges
    llm_server <--> llm_verify
    llm_verify --> llm_scores_db
    llm_server <--> llm_verify_keypaper
    llm_verify_keypaper --> llm_scores_kp_db
    llm_scores_db --> qa_llm_verify
    llm_scores_kp_db --> qa_llm_verify
  end

  %% Active LLM verification profile (model + routing) feeds the verification call
  llm_active@{ shape: rect, label: "Active LLM verification profile<br/><tt>llm_verification.active</tt>" }
  config_file --> llm_active
  llm_active --> llm_verify

  %% Inputs to Phase 2: NLI's own flagged output, plus the candidate-scope
  %% match set computed in the data-prep stage above (see llm_scope there)
  nli_scores_db --> llm_verify
  llm_scope_db --> llm_verify

  %% Input to the key-paper LLM verification chain: Phase 1's own key-paper
  %% NLI scores (ALL of them -- no label/certainty routing for this chain)
  nli_scores_kp_db --> llm_verify_keypaper

  %% Force `llm_verification` to sit below `nli_assessment` (subgraph-to-subgraph
  %% edge). Made invisible via linkStyle below so it doesn't add visual noise.
  nli_assessment --> llm_verification

  %% Styles
  classDef input_file  fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:1.5px;
  classDef config      fill:#ecfccb,stroke:#65a30d,color:#14532d,stroke-width:1px;
  classDef database    fill:#fff3b0,stroke:#b45309,color:#111827,stroke-width:1.5px;
  classDef processing  fill:#bbf7d0,stroke:#16a34a,color:#14532d,stroke-width:1px;
  classDef helper      fill:#e0f2fe,stroke:#0284c7,color:#0f172a,stroke-width:1px;
  classDef disabled    fill:#f1f5f9,stroke:#94a3b8,color:#64748b,stroke-width:1px,stroke-dasharray:4 3;
  classDef qa_report   fill:#ede9fe,stroke:#7c3aed,color:#3b0764,stroke-width:1.5px;

  %% Hide the data → nli_assessment subgraph-level constraint edge (index 37).
  %% Hide the nli_assessment → llm_verification one the same way (index 49,
  %% last edge in the file). Recomputed by hand-counting every edge in
  %% source order after adding the key-paper LLM verification chain
  %% (llm_verify_keypaper/llm_scores_kp_db) and the qa_llm_verify QA report
  %% node to the llm_verification subgraph -- 5 new edges, all after index
  %% 37, which is why only the second index moved (44 -> 49). If you add or
  %% remove edges above either line, recount and bump both indices.
  linkStyle 37 stroke:transparent,fill:none;
  linkStyle 49 stroke:transparent,fill:none;

  class config_file input_file;
  class assessment_list,assessment_id,nli_active,llm_active config;
  class citing_db,refs_db,key_messages_db,zotero_db,works_db,nli_ready_db,nli_scores_db,llm_scope_db,llm_scores_db,llm_scores_kp_db,snowball_db,nli_scores_kp_db database;
  class build_refs,build_key_messages,download_zotero,download_works,snowball,nli_scoring,nli_segment,nli_keypaper_scoring,llm_scope,llm_verify,llm_verify_keypaper processing;
  class sparql,zotero_api,openalex,nli_server,llm_server helper;
  class qa_bm_split,qa_nli_scores,qa_llm_verify qa_report;
